  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:engine": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/engine-smoke.tsx",
