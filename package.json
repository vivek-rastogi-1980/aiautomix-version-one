    "test:plan": "tsx --tsconfig scripts/tsconfig.json scripts/plan-smoke.tsx",
    "test:pdf": "tsx --tsconfig scripts/tsconfig.json scripts/pdf-smoke.tsx",
    "test:security": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/security-smoke.tsx",
    "test:commerce": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/commerce-smoke.tsx",
    "test:admin": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/admin-smoke.tsx",
    "test:admin-ops": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/admin-ops-smoke.tsx",
    "test:research": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/research-smoke.tsx",
    "test:research-product": "tsx --conditions=react-server --tsconfig scripts/tsconfig.json scripts/research-product-smoke.tsx",
