# Supabase — required for authentication, database, and storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Browser-safe key. Use EITHER the legacy anon key OR the newer publishable key
# (sb_publishable_…) — the app accepts both. Set only one:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only service role key (never expose to the browser). Required by
# `npm run sync:workflows`, which writes the AI workflow catalog.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Platform (Sprint 4) -------------------------------------------------
# Required to run any AI workflow. Server-side only — never prefixed NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# Optional model override (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Optional default provider id. Only `openai` is implemented in this release;
# anthropic, gemini and azure-openai are declared and fail loudly if selected.
AI_PROVIDER=openai

# Absolute site URL used to build email confirmation / password-reset links.
# Optional locally (derived from the request); set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Analytics 4 measurement id (analytics are disabled when unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Email delivery (SMTP) ---------------------------------------------------
# Mail is sent over SMTP through a mailbox you already own — no third-party
# email service and no API key. These settings are for Hostinger; any SMTP host
# works with the same four values.
#
# Leave them blank and the site still runs: leads persist, bookings save, and
# every send is recorded as SKIPPED rather than failing. Nothing breaks, you
# simply are not emailed.
SMTP_HOST=smtp.hostinger.com
# 465 uses implicit TLS and is what Hostinger recommends. 587 uses STARTTLS.
SMTP_PORT=465
# The FULL email address, not the local part. `info@example.com`, never `info`.
SMTP_USER=
# The MAILBOX password, set in hPanel -> Emails. Not your hPanel login.
SMTP_PASS=

# --- Lead capture (migration 0005) ------------------------------------------
# Leads always persist to the `leads` table. Email notification is best-effort
# and entirely optional — without SMTP credentials the form still works and the
# lead is still stored, you just are not emailed about it.
#
# Where lead notifications are sent (defaults to contact@aiautomix.com).
LEAD_NOTIFICATION_EMAIL=contact@aiautomix.com

# --- Transactional email to CUSTOMERS (migration 0019) -----------------------
# LEAD_NOTIFICATION_EMAIL above is where *you* are told about a new lead. This
# one is the From address on email sent to the customer — welcome, booking
# confirmation, validation complete.
#
# Leaving it blank is fine: it falls back to SMTP_USER, which is the address
# the server will accept anyway.
#
# IMPORTANT: the address here must be a real mailbox on the domain you
# authenticated with. Hostinger rejects a From that does not match the
# authenticated user, and that rejection is the usual reason a form "sends
# nothing" once credentials ARE set. A display name is fine — the mailbox is
# what has to match:
#
#   TRANSACTIONAL_EMAIL_FROM=AIAutoMix <contact@aiautomix.com>
TRANSACTIONAL_EMAIL_FROM=
